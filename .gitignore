# macOS
.DS_Store

# Secrets — private keys / certs must never be committed (infra PRD §11.3).
# docusign_private_key.pem currently lives untracked in the tree; keep it that way.
*.pem
*.key
*.p12
*.pfx
docusign_private_key.pem

# Stray binary/media dumps that landed in the backend dir
*.mp4
*.V22

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# uploads folder
# contains profile avatars as well as
# .mp3s for future scans
uploads/

# storage folder
# contains uploaded agreement files for re-extraction
storage/

# C extensions
*.so

# sqlite3 database
*.db

# backups
*.backup
# Real client royalty data. `*.db` alone does NOT cover a suffixed copy like
# verax_livetest.db.bak-3hats-1784240592, so `git add -A` would have pushed
# ~900 MB of live statements to GitHub.
*.db.*
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.gz
backups/

# Data fetcher output files (temporary dumps)
catalog_daily_data_*.json
catalog_streaming_stats_*.json
full_history_from_release_*.json
catalog_songstats_data.json
catalog_songstats_streaming_data.json
songstats_data.json
backend_audit.json

