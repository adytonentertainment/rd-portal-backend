@app.on_event("shutdown")
async def shutdown():
    """Cleanup browser contexts on shutdown"""
    global ascap_context, bmi_context, playwright_instance
    if ascap_context:
        await ascap_context.close()
    if bmi_context:
        await bmi_context.close()
    if playwright_instance:
        await playwright_instance.stop()


